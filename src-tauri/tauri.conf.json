{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Azgaar's Fantasy Map Generator",
  "version": "1.138.2",
  "identifier": "top.8desk.fmg-desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Azgaar's Fantasy Map Generator",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Fantasy Map Generator desktop",
    "longDescription": "Azgaar's Fantasy Map Generator packaged as a lightweight native desktop application."
  }
}
